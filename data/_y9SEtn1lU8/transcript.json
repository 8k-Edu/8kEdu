  "text": "in order to customize it."
 },
 {
  "start": 40.77,
  "end": 41.83,
  "text": "And deploy it"
 },
 {
  "start": 41.83,
  "end": 44.87,
  "text": "in all the different industries."
 },
 {
  "start": 44.9,
