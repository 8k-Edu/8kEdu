data/*/video.*
data/*/frames/
# per-request region crops, regenerated on demand
data/*/crops/
# server-owned runtime state, not source (see agent/widget_store.py, agent/flags.py)
data/*/user_concepts*.json*
data/flags.json*
data/pyodide-dist/
data/pyodide
.env
serve.log
nohup.out
.venv/
node_modules/
__pycache__/
dist/

# claude-code plugin skill machinery (per-user, not source). The entries under
# .claude/skills/ are symlinks into .agents/; a skill written by hand is source, so it
# gets negated back in below.
.agents/
.claude/skills/*
!.claude/skills/refactor/
skills-lock.json

# never commit env backups
.env.bak*
.env.*.bak

# pnpm content-addressable store — never track
.pnpm-store/

# OS + build junk
.DS_Store
**/.DS_Store
app/.vite/

# generated by deploy/containment/contain-analyze-cloud.sh
data/8kedu-contain-demo/
